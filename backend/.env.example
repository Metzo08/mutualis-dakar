# Configuration de la base de données PostgreSQL 17
DB_USER=postgres
DB_PASSWORD=changeme_strong_password
DB_NAME=MUTUALIS DAKAR
DB_HOST=localhost
DB_PORT=5432

# Port du serveur backend Express
PORT=5000

# ─────────────────────────────────────────────────────────────────────────────
# DÉPLOIEMENT MULTI-INSTANCE
# ─────────────────────────────────────────────────────────────────────────────
# Quand plusieurs instances tournent derrière un répartiteur de charge, ces
# trois réglages évitent les pannes qui n'apparaissent qu'en production.
#
# 1) POOL DE CONNEXIONS — la contrainte la plus importante
#    PostgreSQL plafonne le nombre total de connexions. La règle à respecter :
#
#        DB_POOL_MAX × nombre d'instances  <  max_connections
#
#    Vérifier la limite réelle :  psql -c "SHOW max_connections;"
#    Exemple : max_connections = 100, 4 instances → DB_POOL_MAX = 15 maximum.
#    Une saturation provoque TOUTES les requêtes en échec d'un coup : on passe
#    d'une montée en charge réussie à une panne totale.
#
# 2) INSTANCE_ID — traçabilité des journaux
#    Chaque instance doit porter un identifiant unique. Sans lui, les
#    journaux de plusieurs instances sont indistincts et il devient
#    impossible de savoir quelle instance a servi une requête donnée.
#
# 3) REALTIME_CHANNEL — canal PostgreSQL LISTEN/NOTIFY
#    Sert à synchroniser la présence des praticiens entre toutes les
#    instances. DOIT être identique sur toutes : un canal divergent
#    revient à n'avoir aucune synchronisation. Nom court, sans espaces.
#
# Rappel : la présence n'est PAS stockée en mémoire d'instance. Elle
# repose sur la base, qui est partagée, donc cohérente entre instances.
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_IDLE_MS=30000
DB_POOL_CONNECT_TIMEOUT_MS=10000
INSTANCE_ID=local
REALTIME_CHANNEL=unamusc_presence

# Secret JWT fort (utilise `openssl rand -hex 64` pour le générer) - OBLIGATOIRE
JWT_SECRET=changeme_generate_a_64_char_random_secret

# Secret refresh token fort (différent du JWT_SECRET) - OBLIGATOIRE
JWT_REFRESH_SECRET=changeme_generate_another_64_char_random_secret

# ─────────────────────────────────────────────────────────────────────────────
# BUS TEMPS RÉEL MULTI-INSTANCE (Redis)
# ─────────────────────────────────────────────────────────────────────────────
# C'est ce canal qui relaie la signalisation WebRTC entre instances : si le
# praticien est sur l'instance A et l'assuré sur l'instance B, l'offre doit
# pouvoir traverser. Redis est utilisé parce que PostgreSQL NOTIFY plafonne
# la taille du payload (SDP de plusieurs kilo-octets), ce qui ferait échouer
# la négociation.
#
# REALTIME_DRIVER — pilote du bus :
#   redis     → Redis Pub/Sub (PRODUCTION, obligatoire en multi-instance)
#   postgres  → PostgreSQL LISTEN/NOTIFY (mono-instance, dépannage)
#   auto      → Redis si REDIS_URL est renseigné, sinon PostgreSQL (défaut)
#
# `auto` permet à la même image de tourner en local sans Redis et en
# production avec.
REALTIME_DRIVER=auto

# REDIS_URL — connexion Redis. En Docker Compose, le nom du service suffit :
#   REDIS_URL=redis://redis:6379
# En local sur la machine hôte :
#   REDIS_URL=redis://localhost:6379
# Laissez VIDE pour rester sur PostgreSQL.
REDIS_URL=

# Délai d'attente de la PREMIÈRE connexion Redis avant bascule sur
# PostgreSQL. Court par choix : une indisponibilité franche de Redis ne doit
# pas retarder le démarrage d'une instance ni faire attendre une
# téléconsultation. La reconnexion en arrière-plan continue ensuite seule.
REDIS_CONNECT_TIMEOUT_MS=5000

# Canaux Pub/Sub. DOIVENT être identiques sur toutes les instances : un canal
# divergent revient à n'avoir aucune synchronisation. La présence et la
# signalisation sont séparées : leurs volumes et leurs durées de vie n'ont
# rien à voir, et les SDP ne doivent pas réveiller les abonnés à la présence.
REALTIME_PRESENCE_CHANNEL=unamusc:presence
REALTIME_SIGNAL_CHANNEL=unamusc:signal

# ─────────────────────────────────────────────────────────────────────────────
# SERVEUR TURN (coturn) — indispensable à la téléconsultation
# ─────────────────────────────────────────────────────────────────────────────
# Sans TURN, la téléconsultation ne fonctionne que si les deux postes arrivent
# à se voir directement : en 4G ou derrière un NAT d'entreprise, ils n'y
# arrivent pas et la vidéo reste bloquée — le cas d'usage principal au Sénégal.
#
# TURN_STATIC_AUTH_SECRET — secret partagé entre le backend et coturn
# (--use-auth-secret côté coturn). Le backend en dérive des identifiants
# éphémères par HMAC-SHA1 (RFC 5766 §14.3) et ne l'expose jamais aux
# navigateurs. Générer :  openssl rand -base64 32
# DOIT être identique à celui du conteneur coturn, sinon les clients
# reçoivent 401 et la négociation échoue sans explication visible.
TURN_STATIC_AUTH_SECRET=

# TURN_REALM — domaine annoncé par coturn. DOIT correspondre au nom public
# joignable depuis Internet : les candidats construits avec un autre nom
# sont invalides et la connexion reste bloquée.
TURN_REALM=mutualis-dakar.sn

# TURN_PUBLIC_URL — URL exposée aux clients pour le relais. Par défaut le
# backend construit turn:<hôte de la requête>:3478. Spécifiez-la explicitement
# si le serveur TURN est sur un autre hôte ou un port non standard :
#   TURN_PUBLIC_URL=turn:turn.mutualis-dakar.sn:3478
TURN_PUBLIC_URL=

# ⚠️ Redis contient des données de session éphémères. Il ne doit PAS être
# exposé sur Internet : il n'est joignable que depuis le réseau interne.
# Sur Compose, c'est le réseau privé qui l'enclôt ; en production, un
# pare-feu ou un réseau privé dédiés.

# Origines frontend autorisées pour CORS (séparées par des virgules)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Clé API Gemini (Optionnelle - laisser vide pour le mode de simulation local)
GEMINI_API_KEY=

# Synthèse vocale (TTS) pour le Chatbot Zahara
# ElevenLabs API (Premium)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Plateforme TTS Open-source locale (ex: xTTS v2 GalsenAI Docker API)
OPEN_SOURCE_TTS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Encaissement multi-MSD — agrégateur Kadev Pay (https://pay.kadev.ci/)
# ─────────────────────────────────────────────────────────────────────────────
# NE JAMAIS committer de vraies clés : ce fichier est un modèle uniquement.
#
# Clés du compte AGRÉGATEUR (la plateforme) : elles signent les appels et
# reçoivent les webhooks. La commission de l'agrégateur est à la charge de
# la plateforme et n'est jamais déduite du reversement d'une MSD.
KADEV_PUBLIC_KEY=
KADEV_SECRET_AGG=

# Une paire de clés par MSD : c'est le compte qui reçoit réellement
# l'argent de SES adhérents (cotisations, renouvellements, dons, parrainage).
# Le code d'union est celui utilisé par les cartes : DKR, PKN, GDW, RFS,
# THS, MBR, STL, KLC, ZGC, DRB.
# KADEV_PUBLIC_DKR=
# KADEV_SECRET_DKR=
# KADEV_PUBLIC_DRB=
# KADEV_SECRET_DRB=

# URL de l'API Kadev (bac à sable ou production)
KADEV_API_BASE=https://api.kadev.ci

# URL publique du serveur (utilisée pour les callbacks de paiement)
SERVER_PUBLIC_URL=http://localhost:5000

# ─────────────────────────────────────────────────────────────────────────────
# Assistant clinique IA — MedGemma (infrastructure privée)
# ─────────────────────────────────────────────────────────────────────────────
# Aide à la DÉCISION pour les professionnels de santé. Ne pose pas de
# diagnostic : la validation clinique reste obligatoire.
#
# Modèle : MedGemma 4B Instruct (texte + vision) via une API compatible
# OpenAI servie par vLLM, Ollama ou llama.cpp. Les données de santé
# restent sur votre infrastructure : aucun appel à un service externe.
#
#   vLLM  : vllm serve google/medgemma-4b-it --port 8000
#   Ollama: ollama serve  (puis MEDGEMMA_MODEL=medgemma:4b)
#
# Sans MEDGEMMA_BASE_URL, l'assistant reste indisponible : aucune réponse
# n'est inventée à sa place.
MEDGEMMA_BASE_URL=
MEDGEMMA_MODEL=medgemma-4b-it
MEDGEMMA_API_KEY=
MEDGEMMA_TIMEOUT_MS=120000

