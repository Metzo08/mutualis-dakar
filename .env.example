# Configuration Frontend MUTUALIS DAKAR (Vite)
# Exemple de configuration pour déploiement en ligne (ex: https://api.mutualis.sn)
VITE_API_URL=https://api.mutualis.sn

# ═════════════════════════════════════════════════════════════════════════════
# INFRASTRUCTURE — lue par `docker compose` LUI-MÊME
# ═════════════════════════════════════════════════════════════════════════════
#
# Ce bloc est utilisé par Compose pour démarrer la stack. La configuration de
# l'application (JWT_SECRET, CORS, IA) reste dans backend/.env, jamais
# versionné.
#
# Générer les secrets :  openssl rand -hex 32
# ═════════════════════════════════════════════════════════════════════════════

# ── Base de données ─────────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=CHANGER_MOI_password_tres_solide
DB_NAME=mutualis

# ── Serveur TURN (Coturn) ───────────────────────────────────────────────────
# OBLIGATOIRES pour que la téléconsultation fonctionne derrière un NAT. Sans
# ces identifiants, le conteneur Coturn refuse de démarrer.
#
# Générer le mot de passe :  openssl rand -base64 24
TURN_USERNAME=mutualis
TURN_PASSWORD=CHANGER_MOI_mot_de_passe_turn_aleatoire

# Le domaine annoncé par le serveur TURN. DOIT correspondre au nom public
# accessible depuis Internet : sinon les clients construisent des candidats
# invalides et la connexion reste bloquée.
TURN_REALM=mutualis-dakar.sn

# Plage de ports relais, à ouvrir dans le pare-feu en UDP ET TCP.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200

# ── Ports exposés ───────────────────────────────────────────────────────────
# 3478 = signalisation TURN : c'est LE port à ouvrir en priorité en UDP.
HTTP_PORT=80
HTTPS_PORT=443
